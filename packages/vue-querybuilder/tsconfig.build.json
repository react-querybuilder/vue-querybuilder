{
  // Declaration-emit-only project: `src/` alone, no tests, no scripts, no config files.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationMap": true,
    "sourceMap": false,
    "rootDir": "src",
    "types": ["vue"]
  },
  "include": ["src/**/*.ts", "src/**/*.vue"],
  "exclude": ["dist", "node_modules", "src/**/*.test.ts", "src/**/*.test-d.ts", "src/**/*.spec.ts"]
}
